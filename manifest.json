{
	"manifest_version": 3,
	"name": "Default Quality for YouTube",
	"version": "1.0.0",
	"description": "Sets a default quality for YouTube videos. It's automatically applied to every video you watch.",
	"permissions": [ "storage" ],
	"icons": {
		"16": "icons/icon-16.png",
		"32": "icons/icon-32.png",
		"48": "icons/icon-48.png",
		"128": "icons/icon-128.png"
	},
	"action": {
		"default_popup": "popup.html",
		"default_title": "Default Quality for YouTube",
		"default_icon": {
			"16": "icons/icon-16.png",
			"32": "icons/icon-32.png"
		}
	},
	"content_scripts": [
		{
			"matches": [ "https://www.youtube.com/*", "https://music.youtube.com/*", "https://www.youtube-nocookie.com/embed/*" ],
			"js": [ "content-player.js" ],
			"world": "MAIN",
			"all_frames": true,
			"run_at": "document_start"
		},
		{
			"matches": [ "https://www.youtube.com/*", "https://music.youtube.com/*", "https://www.youtube-nocookie.com/embed/*" ],
			"js": [ "content-bridge.js" ],
			"all_frames": true,
			"run_at": "document_start"
		}
	]
}
